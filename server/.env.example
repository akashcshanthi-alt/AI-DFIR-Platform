# TRACE AI DFIR Platform Server Configurations
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Falls back to in-memory MongoDB in development)
MONGO_URI=mongodb://127.0.0.1:27017/arclight_dfir

# JWT Authentication Secrets (Cryptographically secure secrets, minimum 32 chars)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Frontend Base URL (for email verification and password reset links)
FRONTEND_URL=http://localhost:5173

# Email / SMTP Configuration (Optional in dev: links will be logged to server console)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
EMAIL_FROM="TRACE AI Security" <no-reply@trace.ai>

# Google / Firebase Identity Provider
# In local development, Google/Firebase ID tokens are verified cryptographically via Google's tokeninfo API or Firebase public keys.
FIREBASE_PROJECT_ID=ai-dfir-platform

# Phase 6: Ollama Local LLM Configuration (AI Investigation Engine)
# ==============================================================================
# 1. Installation:
#    - Windows/macOS/Linux: Download and install from https://ollama.com/download
#    - Verify CLI: `ollama --version`
# 2. Start Ollama Server:
#    - By default, the desktop installer starts the Ollama background daemon on http://127.0.0.1:11434
#    - Or manually run: `ollama serve`
# 3. Pull Recommended Model:
#    - `ollama pull mistral:latest` (or `ollama pull llama3:8b`, `ollama pull qwen2.5:7b`)
# 4. Verify Readiness:
#    - Test HTTP API: `curl http://127.0.0.1:11434/api/tags`
#    - Test platform readiness endpoint: GET /api/ai/readiness (Authorization: Bearer <TOKEN>)
# 5. Troubleshooting Common Failures:
#    - ECONNREFUSED / OFFLINE: Ollama service is not running. Launch Ollama or execute `ollama serve`.
#    - MODEL_NOT_FOUND: The model specified in OLLAMA_MODEL has not been pulled. Run `ollama pull <model-name>`.
#    - TIMEOUT: Heavy model inference exceeding OLLAMA_TIMEOUT_MS. Increase OLLAMA_TIMEOUT_MS or use a smaller/quantized model (e.g., mistral:7b-instruct-q4_0).
#    - HIGH_RESOURCE_USAGE: Allocate more RAM/VRAM or configure OLLAMA_NUM_PARALLEL=1 in system environment variables.
# ==============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_TIMEOUT_MS=60000

